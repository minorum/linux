config SPRD_COMMON_CLK
	tristate "Clock support for Spreadtrum SoCs"
	depends on ARCH_SPRD || ARCH_SC9830 || COMPILE_TEST
	default ARCH_SPRD
	select REGMAP_MMIO

if SPRD_COMMON_CLK

# SoC Drivers

config SPRD_SC9830_GPU_CLK
	tristate "Spreadtrum SC9830 GPU clock"
	depends on ARCH_SC9830 || COMPILE_TEST
	depends on PM_GENERIC_DOMAINS
	help
	  Support the GPU clock mux and divider on Spreadtrum SC9830.
	  The provider acquires the GPU power domain before register access
	  and supports the stock GPU clock sources through the common clock
	  framework. Say Y to enable it for a built-in GPU power provider.

config SPRD_SC9830_CLK
	bool "Support for the Spreadtrum SC9830 clocks"
	depends on SPRD_COMMON_CLK=y
	select RESET_CONTROLLER
	select RESET_SIMPLE
	depends on ARCH_SC9830 || COMPILE_TEST
	help
	  Support for SC9830 peripheral clocks and gates, registered early
	  for the system timer. PLL programming remains provided by firmware.

config SPRD_SC9860_CLK
	tristate "Support for the Spreadtrum SC9860 clocks"
	depends on (ARM64 && ARCH_SPRD) || COMPILE_TEST
	default ARM64 && ARCH_SPRD

config SPRD_SC9830_MM_CLK
	tristate "Spreadtrum SC9830 multimedia clocks and resets"
	depends on ARCH_SC9830 || COMPILE_TEST
	depends on PM_GENERIC_DOMAINS
	select MFD_SYSCON
	depends on RESET_CONTROLLER
	help
	  DCAM and multimedia MMU gates with runtime power-domain ownership.
	  The provider controls multimedia AHB resets and the DCAM clock
	  selection using shared system registers. It requires the SC9830
	  multimedia power domain to be available before register access.

config SPRD_SC9863A_CLK
	tristate "Support for the Spreadtrum SC9863A clocks"
	depends on (ARM64 && ARCH_SPRD) || COMPILE_TEST
	default ARM64 && ARCH_SPRD
	help
	  Support for the global clock controller on sc9863a devices.
	  Say Y if you want to use peripheral devices on sc9863a SoC.

config SPRD_UMS512_CLK
	tristate "Support for the Spreadtrum UMS512 clocks"
	depends on (ARM64 && ARCH_SPRD) || COMPILE_TEST
	default ARM64 && ARCH_SPRD
	help
	  Support for the global clock controller on ums512 devices.
	  Say Y if you want to use peripheral devices on ums512 SoC.
endif
