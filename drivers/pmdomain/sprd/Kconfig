config SC9830_MM_PD
	bool "Spreadtrum SC9830 multimedia power domain"
	depends on ARCH_SC9830 || COMPILE_TEST
	depends on OF && PM
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	help
	  Enable the multimedia power domain on Spreadtrum SC9830.
	  The domain retains its clock configuration across power cycles.
	  Only an initially powered-off domain can be acquired.
	  Register access failures prevent further consumer activation.
