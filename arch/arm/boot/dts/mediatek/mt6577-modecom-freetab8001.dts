/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/mediatek,mt6577-clk.h>

/ {
	model = "MODECOM FreeTAB 8001";
	compatible = "modecom,freetab8001", "mediatek,mt6577";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&sysirq>;

	chosen {
		bootargs = "console=ttyGS0,115200 loglevel=8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
			status = "disabled";
		};
	};

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x04000000>;
	};

	clk13m: clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <13000000>;
	};

	clk26m: clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	msdc_clock: clock-msdc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <197000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		infracfg: clock-controller@c0001000 {
			compatible = "mediatek,mt6577-infracfg";
			reg = <0xc0001000 0x1000>;
			clocks = <&clk26m>, <&apmixedsys CLK_MT6577_MAINPLL>;
			clock-names = "clk26m", "mainpll";
			#clock-cells = <1>;
		};

		apmixedsys: clock-controller@c0007000 {
			compatible = "mediatek,mt6577-apmixedsys";
			reg = <0xc0007000 0x1000>;
			clocks = <&clk26m>;
			clock-names = "clk26m";
			#clock-cells = <1>;
		};

		pericfg: clock-controller@c1000000 {
			compatible = "mediatek,mt6577-pericfg";
			reg = <0xc1000000 0x1000>;
			clocks = <&infracfg CLK_MT6577_AXI>;
			clock-names = "axi";
			#clock-cells = <1>;
		};

		pwm: pwm@c1008000 {
			compatible = "mediatek,mt6577-pwm";
			reg = <0xc1008000 0x210>;
			#pwm-cells = <2>;
			clocks = <&infracfg CLK_MT6577_AXI>, <&pericfg CLK_MT6577_PWM456>,
				 <&pericfg CLK_MT6577_PWM1>, <&pericfg CLK_MT6577_PWM2>,
				 <&pericfg CLK_MT6577_PWM3>, <&pericfg CLK_MT6577_PWM456>,
				 <&pericfg CLK_MT6577_PWM456>, <&pericfg CLK_MT6577_PWM456>,
				 <&pericfg CLK_MT6577_PWM7>;
			clock-names = "top", "main", "pwm1", "pwm2", "pwm3",
				      "pwm4", "pwm5", "pwm6", "pwm7";
		};

		pio: pinctrl@c0005000 {
			compatible = "mediatek,mt6577-pinctrl";
			reg = <0xc0005000 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
		};

		gic: interrupt-controller@c000b000 {
			compatible = "arm,cortex-a9-gic";
			reg = <0xc000b000 0x1000>, <0xc000a100 0x100>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		sysirq: interrupt-controller@c0009050 {
			compatible = "mediatek,mt6577-sysirq";
			reg = <0xc0009050 0x10>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		timer@c1002000 {
			compatible = "mediatek,mt6577-timer";
			reg = <0xc1002000 0x80>;
			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&clk13m>;
			clock-names = "system-clk";
		};

		usb@c1210000 {
			compatible = "mediatek,mt6577-musb-ram";
			reg = <0xc1210000 0x1000>;
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "mc";
			dr_mode = "peripheral";
		};

		mmc@c1220000 {
			compatible = "mediatek,mt6577-mmc-ram";
			reg = <0xc1220000 0x1000>;
			clocks = <&msdc_clock>;
			clock-names = "source";
			bus-width = <4>;
			max-frequency = <12000000>;
			non-removable;
		};
	};
};
