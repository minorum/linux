// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "MODECOM FreeTAB 8001";
	compatible = "modecom,freetab8001", "mediatek,mt6577";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&sysirq>;

	chosen {
		bootargs = "console=ttyGS0,115200 loglevel=8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
			status = "disabled";
		};
	};

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x04000000>;
	};

	clk13m: clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <13000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gic: interrupt-controller@c000b000 {
			compatible = "arm,cortex-a9-gic";
			reg = <0xc000b000 0x1000>, <0xc000a100 0x100>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		sysirq: interrupt-controller@c0009050 {
			compatible = "mediatek,mt6577-sysirq";
			reg = <0xc0009050 0x10>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		timer@c1002000 {
			compatible = "mediatek,mt6577-timer";
			reg = <0xc1002000 0x80>;
			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&clk13m>;
			clock-names = "system-clk";
		};

		usb@c1210000 {
			compatible = "mediatek,mt6577-musb-ram";
			reg = <0xc1210000 0x1000>;
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "mc";
			dr_mode = "peripheral";
		};
	};
};
