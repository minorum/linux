/dts-v1/;

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/mediatek,mt8377-clk.h>
#include <dt-bindings/clock/mediatek,mt8377-mmsys.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6329-auxadc.h>

/ {
	model = "MODECOM FreeTAB 8001";
	compatible = "modecom,freetab8001", "mediatek,mt8377";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&sysirq>;

	aliases {
		i2c0 = &pmic_i2c;
		i2c1 = &charger_i2c;
		serial2 = &uart2;
	};

	chosen {
		bootargs = "console=ttyGS0,115200 loglevel=8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
			status = "disabled";
		};
	};

	memory@10000000 {
		device_type = "memory";
		reg = <0x10000000 0x04000000>;
	};

	clk13m: clock-13m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <13000000>;
	};

	clk26m: clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	backlight: backlight {
		compatible = "gpio-backlight";
		gpios = <&pio 48 GPIO_ACTIVE_HIGH>;
	};

	panel {
		compatible = "modecom,freetab8001-display";
		modecom,control-gpios = <&pio 100 GPIO_ACTIVE_HIGH>,
					<&pio 66 GPIO_ACTIVE_HIGH>,
					<&pio 12 GPIO_ACTIVE_HIGH>,
					<&pio 49 GPIO_ACTIVE_HIGH>,
					<&pio 84 GPIO_ACTIVE_HIGH>,
					<&pio 52 GPIO_ACTIVE_HIGH>;
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dpi_out>;
			};
		};
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3476000>;
		factory-internal-resistance-micro-ohms = <117000>;
		voltage-resistance-table =
			<4179000 117000>,
			<4162000 152000>,
			<4148000 152000>,
			<4135000 152000>,
			<4122000 153000>,
			<4111000 153000>,
			<4101000 155000>,
			<4090000 155000>,
			<4081000 155000>,
			<4077000 160000>,
			<4070000 162000>,
			<4057000 158000>,
			<4037000 158000>,
			<4020000 160000>,
			<4006000 163000>,
			<3995000 163000>,
			<3987000 163000>,
			<3980000 163000>,
			<3977000 167000>,
			<3972000 167000>,
			<3966000 168000>,
			<3958000 167000>,
			<3951000 172000>,
			<3943000 172000>,
			<3938000 175000>,
			<3930000 175000>,
			<3924000 178000>,
			<3917000 180000>,
			<3911000 178000>,
			<3904000 180000>,
			<3900000 185000>,
			<3893000 185000>,
			<3888000 188000>,
			<3881000 190000>,
			<3874000 187000>,
			<3866000 183000>,
			<3858000 182000>,
			<3847000 175000>,
			<3837000 167000>,
			<3828000 162000>,
			<3820000 157000>,
			<3814000 155000>,
			<3811000 157000>,
			<3805000 153000>,
			<3802000 153000>,
			<3799000 157000>,
			<3796000 157000>,
			<3793000 155000>,
			<3790000 158000>,
			<3788000 158000>,
			<3786000 160000>,
			<3785000 162000>,
			<3781000 155000>,
			<3779000 157000>,
			<3778000 158000>,
			<3777000 157000>,
			<3777000 160000>,
			<3776000 158000>,
			<3775000 160000>,
			<3775000 160000>,
			<3773000 160000>,
			<3772000 160000>,
			<3768000 157000>,
			<3766000 158000>,
			<3764000 160000>,
			<3759000 155000>,
			<3753000 155000>,
			<3748000 157000>,
			<3744000 157000>,
			<3735000 155000>,
			<3723000 152000>,
			<3715000 157000>,
			<3703000 157000>,
			<3694000 150000>,
			<3694000 155000>,
			<3692000 157000>,
			<3691000 157000>,
			<3689000 160000>,
			<3687000 165000>,
			<3682000 170000>,
			<3654000 168000>,
			<3594000 168000>,
			<3507000 177000>,
			<3369000 192000>,
			<3314000 192000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 =
			<4174000 100>,
			<4149000 98>,
			<4130000 97>,
			<4115000 95>,
			<4101000 94>,
			<4089000 92>,
			<4078000 91>,
			<4069000 89>,
			<4060000 88>,
			<4052000 86>,
			<4045000 84>,
			<4037000 83>,
			<4030000 81>,
			<4021000 80>,
			<4012000 78>,
			<4003000 77>,
			<3994000 75>,
			<3984000 74>,
			<3975000 72>,
			<3965000 70>,
			<3956000 69>,
			<3947000 67>,
			<3939000 66>,
			<3929000 64>,
			<3919000 63>,
			<3908000 61>,
			<3894000 60>,
			<3881000 58>,
			<3871000 57>,
			<3863000 55>,
			<3856000 53>,
			<3849000 52>,
			<3842000 50>,
			<3836000 49>,
			<3830000 47>,
			<3825000 46>,
			<3819000 44>,
			<3813000 42>,
			<3808000 41>,
			<3803000 39>,
			<3799000 38>,
			<3795000 36>,
			<3790000 35>,
			<3786000 33>,
			<3781000 32>,
			<3776000 30>,
			<3770000 29>,
			<3763000 27>,
			<3757000 25>,
			<3750000 24>,
			<3744000 22>,
			<3739000 21>,
			<3735000 19>,
			<3728000 18>,
			<3721000 16>,
			<3714000 15>,
			<3706000 13>,
			<3695000 11>,
			<3687000 10>,
			<3685000 8>,
			<3681000 7>,
			<3670000 5>,
			<3630000 4>,
			<3560000 2>,
			<3457000 1>,
			<3328000 0>,
			<3309000 0>,
			<3302000 0>,
			<3298000 0>,
			<3296000 0>,
			<3294000 0>,
			<3292000 0>,
			<3290000 0>,
			<3289000 0>,
			<3288000 0>,
			<3287000 0>,
			<3287000 0>,
			<3286000 0>,
			<3286000 0>,
			<3286000 0>,
			<3286000 0>,
			<3284000 0>,
			<3284000 0>,
			<3283000 0>,
			<3282000 0>,
			<3282000 0>;
		constant-charge-current-max-microamp = <500000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		precharge-current-microamp = <100000>;
		charge-term-current-microamp = <200000>;
		over-voltage-threshold-microvolt = <4350000>;
		alert-celsius = <10 40>;
	};

	battery_thermistor: battery-thermistor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		#io-channel-cells = <0>;
		io-channels = <&pmic_adc MT6329_AUXADC_BAT_TEMP>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table = <
			(-20000) 1174
			(-15000) 1166
			(-10000) 1154
			(-5000) 1140
			0 1122
			5000 1101
			10000 1075
			15000 1044
			20000 1008
			25000 968
			30000 923
			35000 873
			40000 820
			45000 765
			50000 708
			55000 650
			60000 594
			65000 539
			70000 486>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&battery_thermistor>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		watchdog@c0000000 {
			compatible = "mediatek,mt8377-wdt";
			reg = <0xc0000000 0x1c>;
			timeout-sec = <31>;
		};

		rtc_clock: power-controller@c1003000 {
			compatible = "mediatek,mt8377-pwrc";
			reg = <0xc1003000 0x7c>;
			#clock-cells = <0>;
		};

		mmsys: clock-controller@c2080000 {
			compatible = "mediatek,mt8377-mmsys", "syscon";
			reg = <0xc2080000 0x1000>;
			#clock-cells = <1>;
		};

		mipi_tx: clock-controller@c20a3800 {
			compatible = "mediatek,mt8377-mipi-tx";
			reg = <0xc20a3800 0x34>;
			clocks = <&clk26m>;
			#clock-cells = <0>;
			mediatek,mmsys = <&mmsys>;
			mediatek,apmixedsys = <&apmixedsys>;
			mediatek,infracfg = <&infracfg>;
		};

		display-controller@c208c000 {
			compatible = "mediatek,mt8377-dpi";
			reg = <0xc208c000 0xb8>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&mmsys CLK_MT8377_MM_DPI>,
				 <&mmsys CLK_MT8377_MM_LARB1>,
				 <&mmsys CLK_MT8377_MM_LARB1_EMI>, <&mipi_tx>;
			clock-names = "engine", "larb", "larb-emi", "pll";
			mediatek,mmsys = <&mmsys>;

			port {
				dpi_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};
		};

		infracfg: clock-controller@c0001000 {
			compatible = "mediatek,mt8377-infracfg";
			reg = <0xc0001000 0x1000>;
			clocks = <&clk26m>, <&apmixedsys CLK_MT8377_MAINPLL>,
				 <&apmixedsys CLK_MT8377_WPLL197>;
			clock-names = "clk26m", "mainpll", "wpll";
			#clock-cells = <1>;
		};

		apmixedsys: clock-controller@c0007000 {
			compatible = "mediatek,mt8377-apmixedsys";
			reg = <0xc0007000 0x1000>;
			clocks = <&clk26m>;
			clock-names = "clk26m";
			#clock-cells = <1>;
		};

		pericfg: clock-controller@c1000000 {
			compatible = "mediatek,mt8377-pericfg";
			reg = <0xc1000000 0x1000>;
			clocks = <&infracfg CLK_MT8377_AXI>, <&clk26m>,
				 <&apmixedsys CLK_MT8377_WPLL197>,
				 <&apmixedsys CLK_MT8377_WPLL61>;
			clock-names = "axi", "clk26m", "wpll197", "wpll61";
			#clock-cells = <1>;
		};

		pwm: pwm@c1008000 {
			compatible = "mediatek,mt8377-pwm";
			reg = <0xc1008000 0x210>;
			#pwm-cells = <2>;
			clocks = <&infracfg CLK_MT8377_AXI>, <&pericfg CLK_MT8377_PWM456>,
				 <&pericfg CLK_MT8377_PWM1>, <&pericfg CLK_MT8377_PWM2>,
				 <&pericfg CLK_MT8377_PWM3>, <&pericfg CLK_MT8377_PWM456>,
				 <&pericfg CLK_MT8377_PWM456>, <&pericfg CLK_MT8377_PWM456>,
				 <&pericfg CLK_MT8377_PWM7>;
			clock-names = "top", "main", "pwm1", "pwm2", "pwm3",
				      "pwm4", "pwm5", "pwm6", "pwm7";
		};

		uart2: serial@c100b000 {
			compatible = "mediatek,mt6577-uart";
			reg = <0xc100b000 0x100>;
			interrupt-parent = <&sysirq>;
			interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_MT8377_UART2>,
				 <&pericfg CLK_MT8377_UART2>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		pio: pinctrl@c0005000 {
			compatible = "mediatek,mt8377-pinctrl";
			reg = <0xc0005000 0x1000>;
			gpio-controller;
			#gpio-cells = <2>;
		};

		gic: interrupt-controller@c000b000 {
			compatible = "arm,cortex-a9-gic";
			reg = <0xc000b000 0x1000>, <0xc000a100 0x100>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		sysirq: interrupt-controller@c0009050 {
			compatible = "mediatek,mt6577-sysirq";
			reg = <0xc0009050 0x10>;
			interrupt-controller;
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-parent = <&gic>;
		};

		timer@c1002000 {
			compatible = "mediatek,mt6577-timer";
			reg = <0xc1002000 0x80>;
			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&clk13m>;
			clock-names = "system-clk";
		};

		charger_i2c: i2c@c1012000 {
			compatible = "mediatek,mt6577-i2c";
			reg = <0xc1012000 0x70>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_MT8377_I2C0>;
			clock-names = "main";
			clock-div = <16>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;

			charger: charger@36 {
				compatible = "onnn,ncp1851";
				reg = <0x36>;
				monitored-battery = <&battery>;
				power-supplies = <&usb_phy>;
				io-channels = <&pmic_adc MT6329_AUXADC_ISENSE>,
					      <&battery_thermistor>;
				io-channel-names = "voltage", "temperature";
				input-current-limit-microamp = <500000>;
				shunt-resistor-micro-ohms = <68000>;
				onnn,power-path;
				onnn,system-voltage-microvolt = <3400000>;
			};
		};

		pmic_i2c: i2c@c1014000 {
			compatible = "mediatek,mt8377-i2c-dual";
			reg = <0xc1014000 0xc0>;
			interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_MT8377_I2C_DUAL>;
			clock-names = "main";
			clock-frequency = <100000>;
			mediatek,use-push-pull;
			#address-cells = <1>;
			#size-cells = <0>;

			pmic@60 {
				compatible = "mediatek,mt6329";
				reg = <0x60>;
				clocks = <&rtc_clock>;
				mediatek,external-charger;

				pmic_adc: adc {
					compatible = "mediatek,mt6329-auxadc";
					#io-channel-cells = <1>;
				};

				pmic_current: current-sensor {
					compatible = "mediatek,mt6329-fgadc";
					#io-channel-cells = <0>;
					va2-supply = <&va2>;
					shunt-resistor-micro-ohms = <20000>;
					mediatek,current-calibration-percent = <101>;
					io-channels = <&pmic_adc MT6329_AUXADC_ISENSE>,
						      <&battery_thermistor>;
					io-channel-names = "voltage", "temperature";
					monitored-battery = <&battery>;
					power-supplies = <&charger>;
				};

				regulators {
					va2: va2 {
						regulator-name = "mt6329-va2";
						regulator-boot-on;
						regulator-always-on;
					};

					vusb: vusb {
						regulator-name = "mt6329-vusb";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-boot-on;
					};

					vmc: vmc {
						regulator-name = "mt6329-vmc";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-boot-on;
						regulator-always-on;
					};
				};
			};
		};

		usb_phy: phy@c1260800 {
			compatible = "mediatek,mt8377-usb-phy";
			reg = <0xc1260800 0x800>;
			clocks = <&apmixedsys CLK_MT8377_UPLL>, <&pericfg CLK_MT8377_USB>;
			clock-names = "upll", "bus";
			vusb33-supply = <&vusb>;
			mediatek,bc11;
			#phy-cells = <0>;
		};

		usb@c1210000 {
			compatible = "mediatek,mt8377-musb";
			reg = <0xc1210000 0x1000>;
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_LOW>;
			interrupt-names = "mc";
			clocks = <&pericfg CLK_MT8377_USB>;
			clock-names = "bus";
			phys = <&usb_phy>;
			phy-names = "usb2-phy";
			dr_mode = "peripheral";
			power-supplies = <&charger>;
		};

		wifi_mmc: mmc@c1240000 {
		};

		mmc@c1220000 {
			compatible = "mediatek,mt8377-mmc";
			reg = <0xc1220000 0x1000>;
			clocks = <&pericfg CLK_MT8377_MSDC0>;
			clock-names = "source";
			bus-width = <4>;
			max-frequency = <52000000>;
			cap-mmc-highspeed;
			no-sdio;
			non-removable;
		};
	};
};

#include "mt8377-modecom-wifi.dtsi"
