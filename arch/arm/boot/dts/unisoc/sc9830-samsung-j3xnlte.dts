/dts-v1/;

#include "sc9830.dtsi"

/ {
	model = "Samsung Galaxy J3 SM-J320FN";
	compatible = "samsung,j3xnlte", "sprd,sc9830";

	aliases {
		serial0 = &uart0;
		i2c2 = &i2c2;
		spi0 = &adi;
	};

	chosen {
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x60000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ddr-training@80000000 {
			reg = <0x80000000 0x1000>;
			no-map;
		};

		debug@86a00000 {
			reg = <0x86a00000 0x200000>;
			no-map;
		};

		modem-shmem@87800000 {
			reg = <0x87800000 0x500000>;
			no-map;
		};

		modem@89600000 {
			reg = <0x89600000 0x4380000>;
			no-map;
		};

		multimedia@9b23b000 {
			reg = <0x9b23b000 0x3939000>;
			no-map;
		};

		framebuffer@9eb74000 {
			reg = <0x9eb74000 0xa8c000>;
			no-map;
		};

		bootloader@9f600000 {
			reg = <0x9f600000 0x708000>;
			no-map;
		};

		ddr-training@b0000000 {
			reg = <0xb0000000 0x1000>;
			no-map;
		};
	};


	ext_32k: clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	ext_26m: clock-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <2600000>;
		charge-full-design-temp-table = <25 2600000>, <10 2400000>,
					       <0 2350000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4285000 100>, <4247000 95>,
			<4192000 90>, <4139000 85>, <4088000 80>,
			<4044000 75>, <3994000 70>, <3959000 65>,
			<3923000 60>, <3873000 55>, <3838000 50>,
			<3816000 45>, <3799000 40>, <3785000 35>,
			<3775000 30>, <3768000 25>, <3750000 20>,
			<3713000 15>, <3689000 10>, <3673000 5>,
			<3400000 0>;
	};

	battery_thermistor: battery-thermistor {
		compatible = "generic-adc-thermal";
		#thermal-sensor-cells = <0>;
		#io-channel-cells = <0>;
		io-channels = <&adc 1>;
		io-channel-names = "sensor-channel";
		temperature-lookup-table-raw;
		temperature-lookup-table = <
			(-30000) 4210
			(-25000) 4035
			(-20000) 3860
			(-15000) 3729
			(-10000) 3591
			(-7000) 3493
			(-5000) 3431
			(-3000) 3344
			(-2000) 3317
			0 3256
			2000 3152
			3000 3101
			5000 3039
			10000 2828
			15000 2619
			20000 2383
			25000 2145
			30000 1930
			35000 1684
			40000 1502
			45000 1311
			47000 1233
			48000 1197
			50000 1121
			52000 1050
			53000 1020
			55000 969
			58000 899
			60000 850
			65000 733
			70000 659
			75000 589
			80000 521
			85000 450
			90000 390>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <0>;
			thermal-sensors = <&battery_thermistor>;
		};
	};

};

&pinctrl {


	i2c2_default: i2c2-pins {
		function = "i2c2";
		groups = "i2c2";
	};

	uart0_default: uart0-pins {
		function = "uart0";
		groups = "uart0";
	};

	emmc_data_default: emmc-data-pins {
		function = "emmc";
		groups = "emmc-data";
		sprd,drive-level = <1>;
		bias-pull-up;
	};

	emmc_clock_default: emmc-clock-pins {
		function = "emmc";
		groups = "emmc-clock";
		sprd,drive-level = <2>;
		bias-disable;
	};

	sdio1_default: sdio1-pins {
		function = "sdio1";
		groups = "sdio1";
	};
};

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_default>;

	connectivity: mcu {
		compatible = "sprd,sc2331";
		vddcon-supply = <&vddcon>;
		vddwifipa-supply = <&vddwifipa>;
		clocks = <&aon_gate CLK_AUX0>;
		clock-names = "ext_clock";
		reset-gpios = <&gpio 130 GPIO_ACTIVE_LOW>;
		host-wake-gpios = <&gpio 97 GPIO_ACTIVE_HIGH>;
		device-wake-gpios = <&gpio 133 GPIO_ACTIVE_HIGH>;
	};
};

&i2c2 {
	status = "okay";
	assigned-clocks = <&ap_clk CLK_I2C2>;
	assigned-clock-parents = <&ext_26m>;
	assigned-clock-rates = <26000000>;
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_default>;

	charger: charger@49 {
		compatible = "siliconmitus,sm5701";
		reg = <0x49>;
		interrupt-parent = <&gpio>;
		interrupts = <92 IRQ_TYPE_EDGE_FALLING>;
	};
};

&adi {
	status = "okay";

	pmic: pmic@0 {
		compatible = "sprd,sc2723";
		reg = <0>;
		spi-max-frequency = <26000000>;
		interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		rtc@80 {
			compatible = "sprd,sc2723-rtc";
			reg = <0x80>;
			interrupts = <2>;
			start-year = <2015>;
		};

		adc: adc@300 {
			compatible = "sprd,sc2723-adc";
			reg = <0x300>;
			interrupts = <0>;
			#io-channel-cells = <1>;
			hwlocks = <&hwlock 4>;
			clocks = <&aon_gate CLK_SINDRV>;
			clock-names = "reference";
			nvmem-cells = <&calibration_state>,
				      <&adc_calibration>, <&adc_small_calibration>;
			nvmem-cell-names = "calibration_state",
					   "big_scale_calib", "small_scale_calib";
		};

		fuel-gauge@500 {
			monitored-battery = <&battery>;
			power-supplies = <&charger>;
			io-channels = <&battery_thermistor>, <&adc 5>;
			io-channel-names = "bat-temp", "bat-voltage";
			compatible = "sprd,sc2723-fgu";
			reg = <0x500>;
			interrupts = <4>;
			nvmem-cells = <&calibration_state>,
				      <&fgu_voltage_calibration>;
			nvmem-cell-names = "calibration_state", "fgu_calib";
			sprd,calib-resistance-micro-ohms = <19900>;
		};

		regulators {
			compatible = "sprd,sc2723-regulator";
			nvmem-cells = <&calibration_state>, <&vddcon_calibration>,
				      <&wifipa_calibration>;
			nvmem-cell-names = "calibration_state", "vddcon",
					   "vddwifipa";

			vddcon: vddcon {
				regulator-name = "vddcon";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <1600000>;
			};

			vddwifipa: vddwifipa {
				regulator-name = "vddwifipa";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};
		};

		efuse@200 {
			compatible = "sprd,sc2723-efuse";
			reg = <0x200>;
			#address-cells = <1>;
			#size-cells = <1>;

			calibration_state: calibration-state@0 {
				reg = <0 1>;
				bits = <7 1>;
			};

			adc_calibration: adc-calibration@7 {
				reg = <7 2>;
			};

			adc_small_calibration: adc-small-calibration@9 {
				reg = <9 2>;
				};

			vddcon_calibration: vddcon-calibration@d,1 {
				reg = <13 1>;
				bits = <1 7>;
			};

			wifipa_calibration: wifipa-calibration@14,4 {
				reg = <20 2>;
				bits = <4 6>;
			};

			fgu_voltage_calibration: fgu-voltage@c {
				reg = <12 2>;
				bits = <0 9>;
			};

			fgu-current@d {
				reg = <13 2>;
				bits = <1 9>;
			};

			fgu-voltage-delta@e {
				reg = <14 1>;
				bits = <2 6>;
			};
		};
	};
};

&usb {
	status = "okay";
	dr_mode = "peripheral";
	maximum-speed = "full-speed";
	phy_type = "utmi";


};

&emmc {
	status = "okay";
	assigned-clocks = <&ap_clk CLK_EMMC>;
	assigned-clock-parents = <&aon_gate CLK_TWPLL_384M>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_clock_default>, <&emmc_data_default>;
	bus-width = <1>;
	max-frequency = <12000000>;
	non-removable;
	no-sd;
	no-sdio;


};

&sdio1 {
	status = "okay";
	assigned-clocks = <&ap_clk CLK_SDIO1>;
	assigned-clock-rates = <96000000>;
	bus-width = <4>;
	max-frequency = <48000000>;
	sprd,phy-delay = <3 3 3>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio1_default>;
	non-removable;
	no-sd;
	no-mmc;
	no-1-8-v;
	mmc-pwrseq = <&connectivity>;

	wifi@1 {
		compatible = "sprd,sc2331-wifi";
		reg = <1>;
		sprd,boot-controller = <&connectivity>;
	};
};
