#include "sc9830-samsung-j3xnlte.dts"

/ {
	model = "Samsung Galaxy J3 SM-J320F";
	compatible = "samsung,j320f", "sprd,sc9830";

	chosen {
		bootargs = "console=ttyGS0 loglevel=7 maxcpus=1 clk_ignore_unused";
	};

	reserved-memory {
		modem@89600000 {
			reg = <0x89600000 0x4280000>;
		};
	};
};

&pm {
	status = "disabled";
};

&mailbox {
	status = "disabled";
};

&{/retention} {
	status = "disabled";
};

&{/reboot-mode@f90} {
	status = "disabled";
};

&pmic {
	regulators {
		emmc_vqmmc: vddgen0 {
			regulator-name = "vdd-emmc-1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};

		emmc_vmmc: vddemmccore {
			regulator-name = "vdd-emmc-3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-always-on;
			regulator-boot-on;
		};
	};
};

&emmc {
	vmmc-supply = <&emmc_vmmc>;
	vqmmc-supply = <&emmc_vqmmc>;
	mmc-ddr-1_8v;
};

&panel_vci {
	status = "okay";
};

&dispc {
	status = "okay";
};

&dsi {
	status = "okay";
};
