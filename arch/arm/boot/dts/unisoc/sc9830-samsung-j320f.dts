#include "sc9830-samsung-j3xnlte.dts"

/ {
	model = "Samsung Galaxy J3 SM-J320F";
	compatible = "samsung,j320f", "sprd,sc9830";

	chosen {
		bootargs = "console=ttyGS0 loglevel=7 maxcpus=1 clk_ignore_unused";
	};

	proximity_vled: regulator-proximity-led {
		compatible = "regulator-fixed";
		regulator-name = "proximity-led";
		gpio = <&gpio 141 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <20000>;
	};

	i2c-proximity {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio 8 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 10 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;

		proximity@60 {
			compatible = "capella,cm36672p";
			reg = <0x60>;
			proximity-near-level = <3>;
			interrupts-extended = <&gpio 95 IRQ_TYPE_EDGE_FALLING>;
			vdd-supply = <&sensor_vdd28>;
			vio-supply = <&sensor_vdd18>;
			vled-supply = <&proximity_vled>;
		};
	};

	touchkey_vcc: regulator-touchkey {
		compatible = "regulator-fixed";
		regulator-name = "touchkey-vcc";
		gpio = <&gpio 140 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	i2c-touchkey {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio 53 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 55 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <10>;

		touchkey@20 {
			compatible = "coreriver,tc350-touchkey";
			reg = <0x20>;
			interrupts-extended = <&gpio 90 IRQ_TYPE_EDGE_FALLING>;
			vcc-supply = <&touchkey_vcc>;
			linux,keycodes = <KEY_APPSELECT KEY_BACK>;
		};
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	reserved-memory {
		modem@89600000 {
			reg = <0x89600000 0x4280000>;
		};
	};
};

&pm {
	status = "disabled";
};

&mailbox {
	status = "disabled";
};

&{/retention} {
	status = "disabled";
};

&{/reboot-mode@f90} {
	status = "disabled";
};

&pmic {
	regulators {
		sensor_vdd18: vdd18 {
			regulator-name = "vdd18";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};

		sensor_vdd28: vdd28 {
			regulator-name = "vdd28";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-always-on;
			regulator-boot-on;
		};

		emmc_vqmmc: vddgen0 {
			regulator-name = "vdd-emmc-1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};

		emmc_vmmc: vddemmccore {
			regulator-name = "vdd-emmc-3p0";
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-always-on;
			regulator-boot-on;
		};
	};
};

&emmc {
	vmmc-supply = <&emmc_vmmc>;
	vqmmc-supply = <&emmc_vqmmc>;
	mmc-ddr-1_8v;
};

&i2c2 {
	accelerometer@18 {
		compatible = "bosch,bma254";
		reg = <0x18>;
		interrupts-extended = <&gpio 135 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "INT1";
		vdd-supply = <&sensor_vdd18>;
		vddio-supply = <&sensor_vdd18>;
		mount-matrix = "0", "-1", "0",
			       "1", "0", "0",
			       "0", "0", "1";
	};
};

&usb {
	maximum-speed = "high-speed";
	g-tx-fifo-size = <64 64 256 256 64 64 64 64
			  64 64 64 64 64 64 64>;
};

&{/soc/mmc@20400000/wifi@1} {
	interrupt-parent = <&gpio>;
	interrupts = <132 IRQ_TYPE_EDGE_RISING>;
};

&sdio1 {
	assigned-clock-rates = <76800000>;
	max-frequency = <38400000>;
	keep-power-in-suspend;
};

&panel_vci {
	status = "okay";
};

&dispc {
	status = "okay";
};

&dsi {
	status = "okay";
};
