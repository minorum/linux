/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "brcm,bcm2153-arm11";
			reg = <0>;
		};
	};

	osc32k: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gpt: timer@8830100 {
			compatible = "brcm,bcm2153-gpt";
			reg = <0x08830100 0x60>;
			clocks = <&osc32k>;
			clock-names = "slow";
			status = "disabled";
		};

		sd1: mmc@8120000 {
			compatible = "brcm,bcm2153-sdhci";
			reg = <0x08120000 0x100>,
			      <0x08128000 0x4>,
			      <0x08140038 0x8>;
			reg-names = "host", "control", "clock";
			clock-frequency = <52000000>;
			status = "disabled";
		};
	};
};
