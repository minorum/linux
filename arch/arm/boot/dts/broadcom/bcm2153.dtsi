#include <dt-bindings/interrupt-controller/irq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&intc>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "brcm,bcm2153-arm11";
			reg = <0>;
		};
	};

	osc32k: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		intc: interrupt-controller@8810000 {
			compatible = "brcm,bcm2153-intc";
			reg = <0x08810000 0x200>;
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <2>;
		};

		bsc0: i2c@88a0020 {
			compatible = "brcm,bcm2153-i2c";
			reg = <0x088a0020 0x30>;
			interrupts = <7 IRQ_TYPE_EDGE_RISING>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		bsc1: i2c@88b0020 {
			compatible = "brcm,bcm2153-i2c";
			reg = <0x088b0020 0x30>;
			interrupts = <13 IRQ_TYPE_EDGE_RISING>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		gpt: timer@8830100 {
			compatible = "brcm,bcm2153-gpt";
			reg = <0x08830100 0x60>;
			interrupts = <11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&osc32k>;
			clock-names = "slow";
			status = "okay";
		};

		sd1: mmc@8120000 {
			compatible = "brcm,bcm2153-sdhci";
			reg = <0x08120000 0x100>,
			      <0x08128000 0xc>,
			      <0x08140038 0x8>;
			reg-names = "host", "control", "clock";
			clock-frequency = <52000000>;
			interrupts = <26 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};
	};
};
