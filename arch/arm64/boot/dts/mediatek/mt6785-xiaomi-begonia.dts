/dts-v1/;
#include "mt6785.dtsi"

/ {
	model = "Xiaomi Redmi Note 8 Pro";
	compatible = "xiaomi,begonia", "mediatek,mt6785";
	chassis-type = "handset";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	firmware {
		cpu-power-management {
			compatible = "mediatek,mt6785-cpu-pm";
		};
	};
};

&uart0 {
	status = "okay";
};
